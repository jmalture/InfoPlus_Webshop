      "html": "<!DOCTYPE html>\r\n<html lang=\"de\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <style>\r\n        * {\r\n            margin: 0;\r\n            padding: 0;\r\n            box-sizing: border-box;\r\n        }\r\n\r\n        body {\r\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;\r\n            color: #333;\r\n            line-height: 1.8;\r\n        }\r\n\r\n        .page-container {\r\n            max-width: 1200px;\r\n            margin: 0 auto;\r\n            padding: 4rem 2rem;\r\n        }\r\n\r\n        /* Header Section */\r\n        .page-header {\r\n            text-align: center;\r\n            margin-bottom: 4rem;\r\n        }\r\n\r\n        .page-title {\r\n            font-size: 3rem;\r\n            font-weight: 700;\r\n            color: #e91e8c;\r\n            margin-bottom: 1rem;\r\n        }\r\n\r\n        .page-subtitle {\r\n            font-size: 1.3rem;\r\n            color: #666;\r\n            font-weight: 400;\r\n        }\r\n\r\n        /* Highlights Section */\r\n        .highlights {\r\n            background: white;\r\n            padding: 2.5rem 3rem;\r\n            border-radius: 20px;\r\n            margin-bottom: 3rem;\r\n        }\r\n\r\n        .highlights-list {\r\n            list-style: none;\r\n            display: grid;\r\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\r\n            gap: 1.5rem;\r\n        }\r\n\r\n        .highlights-list li {\r\n            font-size: 1rem;\r\n            color: #333;\r\n            font-weight: 500;\r\n            padding-left: 2rem;\r\n            position: relative;\r\n        }\r\n\r\n        .highlights-list li:before {\r\n            content: \"✓\";\r\n            position: absolute;\r\n            left: 0;\r\n            color: #e91e8c;\r\n            font-weight: 700;\r\n            font-